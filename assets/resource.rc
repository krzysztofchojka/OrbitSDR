#include <winver.h>

IDI_ICON1 ICON "icon.ico"

// Version information: an executable without it looks anonymous to antivirus
// heuristics (Windows Defender "!ml" detections), so keep this block.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "OrbitSDR"
            VALUE "FileDescription",  "OrbitSDR - SDR receiver and satellite tracker"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "orbitsdr"
            VALUE "LegalCopyright",   "See LICENSE"
            VALUE "OriginalFilename", "orbitsdr.exe"
            VALUE "ProductName",      "OrbitSDR"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
